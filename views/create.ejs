<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crear Registro</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>
<body>
    <div class="container mt-4">
        <div class="card border-secondary">
            <div class="card-header">Nueva Película</div>
            <div class="card-body">
                <form action="/save" method="POST">
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label for="titulo" class="form-label">Título</label>
                            <input type="text" class="form-control" id="titulo" name="titulo" tabindex="1" required>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="duracionmin" class="form-label">Duración (Min)</label>
                            <input type="number" class="form-control" id="duracionmin" name="duracionmin" tabindex="2" required>
                        </div>
                        <div class="col-md-6">
                            <label for="estreno" class="form-label">Estreno</label>
                            <input type="text" class="form-control" id="estreno" name="estreno" tabindex="3" required>
                        </div>
                    </div>
            </div>
            <div class="card-footer">
                <button type="submit" class="btn btn-primary" tabindex="4">Guardar</button>
                <a href="/" class="btn btn-secondary" tabindex="5">Cancelar</a>
            </div>
                </form>
        </div>
    </div>
</body>
</html>