<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CRUD Node.js</title>
    <!-- CDN Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>
<body>
    <div class="container">
        <a href="/create" class="btn btn-outline-primary mt-4"><i class='bx bxs-plus-square'></i> Crear</a>
        <table class="table table-bordered table-striped text-center mt-4">
            <thead>
                <tr class="bg-primary text-white">
                    <th scope="col">ID</th>
                    <th scope="col">TITULO</th>
                    <th scope="col">DURACION (MIN)</th>
                    <th scope="col">ESTRENO</th>
                    <th scope="col">ACCIONES</th>
                </tr>
            </thead>
            <tbody>
                <% results.forEach((pelicula) => { %>
                    <tr>
                        <td><%= pelicula.id %></td>
                        <td><%= pelicula.titulo %></td>
                        <td><%= pelicula.duracionmin %></td>
                        <td><%= pelicula.estreno %></td>
                        <td>
                            <a href="/edit/<%= pelicula.id %>" class="btn btn-outline-info">Editar</a>
                            <a href="/delete/<%= pelicula.id %>" class="btn btn-outline-danger">Borrar</a>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</body>
</html>